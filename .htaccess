DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://nanomedia.com.br%{REQUEST_URI} [R=301,L]

# Canonical host: remove www
RewriteCond %{HTTP_HOST} ^www\.nanomedia\.com\.br$ [NC]
RewriteRule ^ https://nanomedia.com.br%{REQUEST_URI} [R=301,L]
